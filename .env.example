# Copy to .env and keep that file local. Never commit a real credential.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lab28-ong-xuan-son
LANGSMITH_TRACING=true

# Host-side CLI and integration tests reach vLLM through localhost.
LAB28_VLLM_BASE_URL=http://localhost:8001/v1
# The API container reaches the same host process through Docker's host alias.
LAB28_VLLM_CONTAINER_BASE_URL=http://host.docker.internal:8001/v1
LAB28_VLLM_MODEL_ID=Qwen/Qwen3-0.6B
LAB28_VLLM_REQUIRE_REAL=true
LAB28_VLLM_TIMEOUT=120
LAB28_VLLM_MAX_TOKENS=96
LAB28_VLLM_ENABLE_THINKING=false

# Set only when the vLLM endpoint itself requires bearer authentication.
# LAB28_VLLM_API_KEY=
